    <!-- Main Vertical Layout Container for Dynamic Multiselect -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/controlHalfMarginBottom">

        <!-- Removed: error_indicators_layout - now inline with label -->

        <!-- First Horizontal Layout: Group Label Section -->
        <LinearLayout
            android:id="@+id/label_frame"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/label"
                style="@style/ControlLabelStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="60dp"
                android:focusable="false" />
            <!-- 60dp margin makes sure indicators are always visible -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="-60dp">

                <TextView
                    android:id="@+id/required_indicator"
                    android:focusable="false"
                    style="@style/RequiredIndicatorStyle"/>

                <TextView
                    android:id="@+id/soft_required_indicator"
                    android:focusable="false"
                    style="@style/SoftRequiredIndicatorStyle"/>

                <TextView
                    android:id="@+id/error_indicator"
                    android:focusable="false"
                    style="@style/ErrorIndicatorStyle"/>

                <TextView
                    android:id="@+id/warning_indicator"
                    android:focusable="false"
                    style="@style/WarningIndicatorStyle"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Second Section: Dynamic Checkboxes Container -->
        <LinearLayout
            android:id="@+id/dynamic_checkboxes_container"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Checkboxes will be added here programmatically -->

        </LinearLayout>

        <!-- Third Horizontal Layout: Error Indicators - REMOVED -->

    </LinearLayout>
</merge>